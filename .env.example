# Get a personal access token at https://www.discogs.com/settings/developers
DISCOGS_USERNAME=
DISCOGS_TOKEN=
DISCOGS_USER_AGENT=DiscogsDashboard/0.1 (+local-dev)

DATABASE_URL=file:./data/dashboard.db

# Optional. Auto-provisioned on Vercel when you connect the Upstash for Redis
# Marketplace integration (Vercel Dashboard → Storage → Connect Database).
# Used to cache the marketplace price-map across cold starts so the median
# price sort returns in ~50ms instead of rebuilding from Discogs. If unset,
# the price cache falls back to local SQLite (release_prices table) — fine
# for local dev, slow on Vercel because /tmp is wiped between cold starts.
# To use locally too: `vercel env pull .env.local --yes` after connecting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
